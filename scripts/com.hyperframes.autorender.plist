<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 唯一标识符 -->
  <key>Label</key>
  <string>com.hyperframes.autorender</string>

  <!-- 运行脚本 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dingfeng/Documents/vibe-coding/HyperFrames/scripts/auto-render.sh</string>
  </array>

  <!-- 监听 output/ 目录变化，有新文件写入时自动触发 -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/dingfeng/Documents/vibe-coding/HyperFrames/output</string>
  </array>

  <!-- 日志 -->
  <key>StandardOutPath</key>
  <string>/Users/dingfeng/Documents/vibe-coding/HyperFrames/scripts/auto-render.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dingfeng/Documents/vibe-coding/HyperFrames/scripts/auto-render.log</string>

  <!-- 环境变量（确保 node/npm 在 PATH 中）-->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/dingfeng</string>
  </dict>

  <!-- 崩溃后自动重启 -->
  <key>KeepAlive</key>
  <false/>

  <!-- 启动时不立即运行，等待触发 -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
